{
  "uid": "muse",
  "title": "muse",
  "tags": [
    "muse",
    "music"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Search latency (quantiles)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(muse_search_seconds_bucket[10m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(muse_search_seconds_bucket[10m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(muse_search_seconds_bucket[10m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Search stage p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(muse_search_stage_seconds_bucket[10m])))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Where search time goes (mean s/s, stacked)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (stage) (rate(muse_search_stage_seconds_sum[10m]))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Searches per minute by intent",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "opm"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (intent) (rate(muse_search_total[10m])) * 60",
          "legendFormat": "{{intent}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Time to first audio byte",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(muse_stream_first_byte_seconds_bucket[30m])))",
          "legendFormat": "{{source}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(muse_stream_first_byte_seconds_bucket[30m])))",
          "legendFormat": "{{source}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stream starts per hour by source",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (source) (increase(muse_stream_total[1h]))",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "External APIs p95 (ListenBrainz / Soulseek / YouTube Music)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(muse_listenbrainz_seconds_bucket[30m])))",
          "legendFormat": "LB {{endpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(muse_slskd_search_seconds_bucket[30m])))",
          "legendFormat": "slskd search",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, op) (rate(muse_ytm_seconds_bucket[30m])))",
          "legendFormat": "ytm {{op}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Mirror Postgres p95 by query",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, query) (rate(muse_pg_seconds_bucket[30m])))",
          "legendFormat": "{{query}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Library fetches per hour (source, outcome)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (source, ok) (increase(muse_fetch_total[1h]))",
          "legendFormat": "{{source}} ok={{ok}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Fetch duration p50 by source",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(muse_fetch_seconds_bucket[6h])))",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Jobs in flight / library size",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "muse_jobs_active",
          "legendFormat": "jobs",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "muse_library_tracks",
          "legendFormat": "library tracks",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "MB replication lag",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 172800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "muse_mb_replication_lag_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "muse.* index age",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1209600
              },
              {
                "color": "red",
                "value": 2592000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "muse_mb_index_age_seconds",
          "refId": "A"
        }
      ]
    }
  ],
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      }
    ]
  }
}