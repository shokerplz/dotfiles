{
  "uid": "services-overview",
  "title": "Services · Overview",
  "description": "Provisioned service health dashboard. Current checks are freshness-gated; missing data is unknown. See panel descriptions for scope and limits.",
  "tags": [
    "self-hosted",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "links": [
    {
      "title": "Service overview",
      "url": "/d/services-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "GitLab",
      "url": "/d/services-gitlab",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Kino",
      "url": "/d/services-kino",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Muse",
      "url": "/d/muse",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Monitoring pipeline",
      "url": "/d/services-monitoring",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(up{job=\"node\"}, host)",
          "refId": "host"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Recent checks: green = pass, red = fail, grey = unknown. Public paths include DNS, TLS and the proxy; direct probes check the backend."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Service reachability",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "table",
      "title": "Public access",
      "description": "Latest edge probes through the declared public ingress. The host label identifies the backend; ingress identifies the proxy. Missing or stale results are unknown.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Fail",
                  "color": "red"
                },
                "1": {
                  "text": "Pass",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 68
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Check"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox\",host=~\"$host\",layer=\"edge\"} and on (job, instance) (up{job=\"blackbox\"} == 1) and on (job, instance) (time() - timestamp(probe_success{job=\"blackbox\"}) < 90)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "State",
            "desc": false
          },
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "ingress": true,
              "layer": true,
              "collector": true
            },
            "renameByName": {
              "Value": "State",
              "service": "Service",
              "check": "Check",
              "host": "Host"
            },
            "indexByName": {
              "Value": 0,
              "service": 1,
              "check": 2,
              "host": 3
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Direct services",
      "description": "Direct backend checks bypass the public ingress. Compare with the same service in Public routes to locate failure scope.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Fail",
                  "color": "red"
                },
                "1": {
                  "text": "Pass",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 68
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Check"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox\",host=~\"$host\",layer=\"core\"} and on (job, instance) (up{job=\"blackbox\"} == 1) and on (job, instance) (time() - timestamp(probe_success{job=\"blackbox\"}) < 90)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "State",
            "desc": false
          },
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "ingress": true,
              "layer": true,
              "collector": true
            },
            "renameByName": {
              "Value": "State",
              "service": "Service",
              "check": "Check",
              "host": "Host"
            },
            "indexByName": {
              "Value": 0,
              "service": 1,
              "check": 2,
              "host": 3
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Probe duration",
      "description": "End-to-end duration of each configured probe, including failed attempts. Historical data; gaps are not bridged.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox\",host=~\"$host\",layer=\"edge\"}",
          "legendFormat": "{{service}} / {{layer}} / {{check}}",
          "instant": false,
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Successful checks · 24h",
      "description": "Rolling fraction of successful recorded probe samples, not a current status or a wall-clock uptime guarantee. Missing scrapes are not counted as successful samples.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg_over_time(probe_success{job=\"blackbox\",host=~\"$host\",layer=\"edge\"}[24h])",
          "legendFormat": "{{service}} / {{layer}} / {{check}}",
          "instant": false,
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Failures, freshness and alert rule state",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Current failed application checks",
      "description": "Only failed checks from a successfully scraped host with a check run in the last 10 minutes. No rows does not prove health: inspect check freshness and node scrape status.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Fail",
                  "color": "red"
                },
                "1": {
                  "text": "Pass",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "(service_check_success{host=~\"$host\"} and on (host, service, check, dependency) (time() - service_check_last_run_timestamp_seconds < 600) and on (host) ((up{job=\"node\"} and (time() - timestamp(up{job=\"node\"}) < 90)) == 1)) == 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "Value": "Result"
            },
            "indexByName": {
              "service": 0,
              "check": 1,
              "dependency": 2,
              "host": 3,
              "Value": 4,
              "instance": 5
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Alert rules: pending and firing",
      "description": "Prometheus rule state only. Firing alerts can be inhibited, silenced or grouped by Alertmanager; this panel does not confirm that a notification was delivered. No rows means no matching active rule series.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertstate"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pending": {
                        "text": "Pending",
                        "color": "yellow"
                      },
                      "firing": {
                        "text": "Firing",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "text": "Critical"
                      },
                      "warning": {
                        "color": "yellow",
                        "text": "Warning"
                      },
                      "info": {
                        "color": "blue",
                        "text": "Info"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "max by (alertname, alertstate, host, service, scope, severity) (ALERTS{alertstate=~\"pending|firing\",host=~\"$host\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "Value": true
            },
            "indexByName": {
              "severity": 0,
              "alertstate": 1,
              "alertname": 2,
              "service": 3,
              "host": 4,
              "scope": 5
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Oldest application check per host",
      "description": "Age of the oldest exported application check. At 10 minutes the corresponding current health result becomes unknown. A failed node scrape also invalidates current health.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "custom": {
            "align": "left",
            "minWidth": 60,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "Unknown",
                        "color": "gray"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "max by (host) (time() - service_check_last_run_timestamp_seconds{host=~\"$host\"})",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Age",
            "desc": true
          },
          {
            "displayName": "Host",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "host",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "host": 0,
              "Value": 1
            },
            "renameByName": {
              "host": "Host",
              "Value": "Age"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Host metrics scrape now",
      "description": "A successful node exporter scrape proves metric transport, not host or application health. Stale scrape samples become unknown after 90 seconds.",
