      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Notification failures per second",
      "description": "Prometheus errors sending alerts to Alertmanager, and Alertmanager failures attempting receiver delivery. This does not confirm message receipt.",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(prometheus_notifications_errors_total[$__rate_interval])",
          "legendFormat": "Prometheus → {{alertmanager}}",
          "instant": false,
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "sum by (integration) (rate(alertmanager_notifications_failed_total[$__rate_interval]))",
          "legendFormat": "Alertmanager → {{integration}}",
          "instant": false,
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Alertmanager notification attempts",
