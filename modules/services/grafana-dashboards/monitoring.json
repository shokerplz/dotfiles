    {
      "id": 18,
      "type": "logs",
      "title": "Monitoring journal diagnostics",
      "description": "Optional Loki view of journal messages containing error, warning, failure or fatal. Messages are diagnostic context, not a health verdict. Uses the configured Alloy host and unit labels.",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{job=\"systemd-journal\",host=~\"rpi5|media-server\",unit=~\"(prometheus|alertmanager|prometheus-alertmanager|grafana|loki|alloy|nginx)\\\\.service\"} |~ \"(?i)(error|warn|fail|fatal)\"",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
